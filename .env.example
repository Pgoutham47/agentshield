# Reference only. Export through your shell or hosting provider; do not commit real values.
AGENTSHIELD_ANALYZER=fixture
AGENTSHIELD_DATA_DIR=data
# Live analyzer is opt-in. No model identifier is assumed.
# ANTHROPIC_API_KEY=
# ANTHROPIC_MODEL=
# AGENTSHIELD_OPERATOR_TOKEN=
# AGENTSHIELD_DEVELOPER_TOKEN=
# AGENTSHIELD_WORKER_TOKEN=
# AGENTSHIELD_REVIEWER_TOKEN=

# Optional GitHub App pilot (see docs/github-integration.md)
# AGENTSHIELD_GITHUB_REPOSITORY=owner/repository
# GITHUB_AUTH_MODE=app
# GITHUB_APP_ID=
# GITHUB_INSTALLATION_ID=
# GITHUB_PRIVATE_KEY_PATH=/absolute/path/private-key.pem
# GITHUB_ENABLE_WRITES=false
# Development CLI mode additionally needs GITHUB_DEV_ACCOUNT and
# AGENTSHIELD_ALLOW_GH_DEV_AUTH=true. Never enable CLI mode on a shared host.

# Supabase PostgreSQL: server-side session pooler, port 5432, URL-encoded password.
# DATABASE_URL=postgresql://postgres.PROJECT_REF:PASSWORD@POOLER_HOST:5432/postgres?sslmode=require
# AGENTSHIELD_DB_SCHEMA=agentshield
# Do not put DATABASE_URL or the database password into frontend code.

# Optional real user login. All four required together; HTTPS origin, no trailing path.
# SUPABASE_URL=https://PROJECT_REF.supabase.co
# SUPABASE_PUBLISHABLE_KEY=sb_publishable_...
# APP_BASE_URL=https://agentshield-prototype.onrender.com
# APP_SESSION_SECRET=generate-a-random-secret-of-at-least-32-characters
# Immutable numeric GitHub ID, configured by operator; never a login/email/metadata role.
# AGENTSHIELD_OWNER_GITHUB_ID=140201744

# Optional self-service repository connections; all three plus GITHUB_APP_ID and Auth required.
# GITHUB_APP_CLIENT_ID=
# GITHUB_APP_CLIENT_SECRET=
# GITHUB_APP_SLUG=
